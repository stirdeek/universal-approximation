cat > .gitignore << 'EOF'
# LaTeX временные файлы
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.pdf

# Python временные файлы
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Системные файлы
.DS_Store
Thumbs.db

# Директории
plots/Figure_*.png  # если графики генерируются автоматически
EOF

